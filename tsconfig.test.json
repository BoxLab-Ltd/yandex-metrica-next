{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "isolatedDeclarations": false,
        "noUnusedLocals": false
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.test-d.ts",
        "test",
        "vitest.config.ts",
        "scripts",
        "e2e",
        "playwright.config.ts"
    ],
    "exclude": ["node_modules", "dist", "research", "test/types"]
}
