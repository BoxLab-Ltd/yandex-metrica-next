{
    "name": "@boxlab/yandex-metrica-next",
    "version": "0.0.0",
    "description": "Yandex Metrica (Яндекс.Метрика / Yandex Metrika) for Next.js — App Router & Pages Router, correct SPA pageviews, typed goals, zero dependencies. Unofficial.",
    "license": "MIT",
    "author": "BoxLab Ltd",
    "type": "module",
    "files": [
        "dist",
        "AGENTS.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BoxLab-Ltd/yandex-metrica-next.git"
    },
    "homepage": "https://github.com/BoxLab-Ltd/yandex-metrica-next#readme",
    "bugs": {
        "url": "https://github.com/BoxLab-Ltd/yandex-metrica-next/issues"
    },
    "keywords": [
        "yandex",
        "metrica",
        "metrika",
        "yandex-metrica",
        "yandex-metrika",
        "next",
        "nextjs",
        "next.js",
        "app-router",
        "pages-router",
        "react",
        "rsc",
        "analytics",
        "web-analytics",
        "tracking",
        "pageview",
        "reach-goal",
        "webvisor",
        "typescript",
        "яндекс-метрика"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./testing": {
            "import": {
                "types": "./dist/testing/index.d.ts",
                "default": "./dist/testing/index.js"
            },
            "require": {
                "types": "./dist/testing/index.d.cts",
                "default": "./dist/testing/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "typesVersions": {
        "*": {
            "*": [
                "./dist/index.d.cts"
            ],
            "testing": [
                "./dist/testing/index.d.cts"
            ]
        }
    },
    "peerDependencies": {
        "@types/react": "*",
        "@types/react-dom": "*",
        "next": "^15.0.0 || ^16.0.0-0",
        "react": "^18.2.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "@types/react-dom": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "bun@1.3.10",
    "scripts": {
        "build": "tsdown",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:pkg": "publint --strict",
        "postbuild": "node scripts/assert-prod-strip.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "next": "^16.3.3",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsdown": "^0.22.14",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    }
}
